# Clash of Clans API key, scoped to the RoyaleAPI proxy's static IP
# (45.79.218.79). Get it from developer.clashofclans.com. Server-side only,
# never exposed to the browser. See SETUP.md.
CLASH_API_TOKEN=

# RoyaleAPI proxy base URL (keeps the IP-locked key working from GitHub
# Actions runners, which have no fixed IP of their own).
CLASH_API_BASE_URL=https://cocproxy.royaleapi.dev/v1

# Supabase service role key: bypasses RLS, so this must only ever live here
# and in the GitHub Actions secret used to run this script. Never in the
# browser, never in apps/web.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Safety cap on how many registered clans one collector run will process.
MAX_CLANS_PER_RUN=20
