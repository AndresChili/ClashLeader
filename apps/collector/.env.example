# Clave de la API de Clash of Clans, atada a la IP fija del proxy de
# RoyaleAPI (45.79.218.79). Se obtiene en developer.clashofclans.com. Solo
# del lado del servidor, nunca se expone al navegador.
CLASH_API_TOKEN=

# URL base del proxy de RoyaleAPI (mantiene funcionando la clave atada a
# IP desde los runners de GitHub Actions, que no tienen IP fija propia).
CLASH_API_BASE_URL=https://cocproxy.royaleapi.dev/v1

# Clave de servicio de Supabase: se salta RLS, así que solo debe vivir aquí
# y en el secreto de GitHub Actions que ejecuta este script. Nunca en el
# navegador, nunca en apps/web.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Tope de seguridad de cuántos clanes registrados procesa una ejecución del recolector.
MAX_CLANS_PER_RUN=20
